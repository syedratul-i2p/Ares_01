{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ARES-01 Rover Mission Control",
  "version": "0.1.0",
  "identifier": "com.ares01.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ARES-01 Rover Mission Control Platform",
        "width": 1200,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "theme": "Dark",
        "backgroundColor": [10, 10, 10, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src 'self' http://* https://* ws://* wss://*; img-src 'self' http://* https://* data: blob:; media-src 'self' http://* https://* data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["bin/esptool"]
  }
}
